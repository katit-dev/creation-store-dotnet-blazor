@inherits LayoutComponentBase
@implements IDisposable

@using CreationStore.Blazor.Services

@inject NavigationManager NavigationManager
@inject UserStateService UserStateService
@inject CartStateService CartStateService
<header>
    <div class="cs-topbar text-white small">
        <div class="container d-flex justify-content-between align-items-center py-2">
            <div class="d-flex align-items-center gap-3">
                <span>
                    <i class="fas fa-gift me-1"></i>
                    20% off your first order
                </span>

                <span class="vr opacity-50"></span>

                <span>Free shipping from 200,000đ</span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <a href="#" class="text-white text-decoration-none">
                    <i class="far fa-bell me-1"></i>Notifications
                </a>

                <a href="#" class="text-white text-decoration-none">
                    <i class="far fa-question-circle me-1"></i>Support
                </a>

                <a href="#" class="text-white text-decoration-none">
                    <i class="fas fa-globe me-1"></i>English
                </a>

                @if (UserStateService.IsAuthenticated)
                {
                    <span>
                        <i class="fas fa-user-circle me-1"></i>
                        @(UserStateService.CurrentUser?.Username ?? "Account")
                    </span>

                    <button class="btn btn-sm cs-btn-outline" @onclick="HandleLogout">
                        Logout
                    </button>
                }
                else
                {
                    <a href="/login" class="text-white text-decoration-none">
                        Login
                    </a>

                    <span class="vr opacity-50"></span>

                    <a href="/register" class="text-white text-decoration-none">
                        Register
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="cs-header-main text-white">
        <div class="container d-flex align-items-center gap-4 py-3">
            <a href="/" class="text-white text-decoration-none d-flex align-items-center gap-3">
                <div class="cs-logo-box">
                    <i class="fas fa-store fa-lg"></i>
                </div>

                <span class="fs-3 fw-semibold">
                    Creation Store
                </span>
            </a>

            <form class="flex-grow-1" @onsubmit="HandleSearch" @onsubmit:preventDefault="true">
                <div class="cs-search-box d-flex">
                    <input type="text" class="form-control border-0 shadow-none"
                           placeholder="Search products in Creation Store" @bind="Keyword" @bind:event="oninput" />

                    <button type="submit" class="btn cs-btn-primary px-4">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </form>

            <a href="/cart" class="text-white text-decoration-none d-flex align-items-center gap-2 position-relative">
                <div class="position-relative">
                    <i class="fas fa-shopping-cart fa-2x"></i>

                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill cs-badge-cart">
                        @(UserStateService.IsAuthenticated ? CartStateService.CartItemCount : 0)
                    </span>
                </div>

                <div class="d-none d-md-block">
                    <div>Cart</div>

                    <div class="small cs-muted">
                        @FormatCurrency(UserStateService.IsAuthenticated ? CartStateService.TotalAmount : 0)
                    </div>
                </div>
            </a>
        </div>
    </div>

    <nav class="cs-navbar text-white">
        <div class="container d-flex align-items-center gap-5 py-2">
            <a href="/" class="text-white text-decoration-none py-2">
                <i class="fas fa-home me-2"></i>Home
            </a>

            <a href="/products" class="text-white text-decoration-none py-2">
                <i class="fas fa-gift me-2"></i>Products
            </a>

            <a href="/cart" class="text-white text-decoration-none py-2">
                <i class="fas fa-shopping-cart me-2"></i>Cart
            </a>

            <a href="/my-orders" class="text-white text-decoration-none py-2">
                <i class="fas fa-cube me-2"></i>My Orders
            </a>

            @if (UserStateService.IsAdmin)
            {
                <a href="/admin/dashboard" class="text-white text-decoration-none py-2">
                    <i class="fas fa-shield-alt me-2"></i>Admin
                </a>
            }
        </div>
    </nav>
</header>

<main class="cs-page">
    <div class="container py-4">
        @Body
    </div>
</main>

<footer class="cs-footer text-white border-top">
    <div class="container py-4">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="cs-logo-box">
                        <i class="fas fa-store"></i>
                    </div>

                    <h5 class="mb-0">Creation Store</h5>
                </div>

                <p class="cs-muted">
                    We provide high-quality digital products with reliable service and competitive prices.
                </p>

                <div class="d-flex gap-3">
                    <a href="#" class="text-white">
                        <i class="fab fa-facebook"></i>
                    </a>

                    <a href="#" class="text-white">
                        <i class="fab fa-instagram"></i>
                    </a>

                    <a href="#" class="text-white">
                        <i class="fab fa-youtube"></i>
                    </a>

                    <a href="#" class="text-white">
                        <i class="far fa-envelope"></i>
                    </a>
                </div>
            </div>

            <div class="col-md-2">
                <h6>About Us</h6>

                <ul class="list-unstyled cs-muted small">
                    <li class="mb-2">Introduction</li>
                    <li class="mb-2">Terms of Service</li>
                    <li class="mb-2">Privacy Policy</li>
                    <li class="mb-2">Contact</li>
                </ul>
            </div>

            <div class="col-md-3">
                <h6>Support</h6>

                <ul class="list-unstyled cs-muted small">
                    <li class="mb-2">Shopping Guide</li>
                    <li class="mb-2">Payment Methods</li>
                    <li class="mb-2">Return Policy</li>
                    <li class="mb-2">FAQ</li>
                </ul>
            </div>

            <div class="col-md-3">
                <h6>Contact</h6>

                <p class="cs-muted small mb-2">
                    Email: support&#64;creationstore.vn
                </p>

                <p class="cs-muted small mb-2">
                    Hotline: 0123 456 789
                </p>

                <p class="cs-muted small mb-0">
                    Working hours: 8:00 - 22:00
                </p>
            </div>
        </div>

        <div class="text-center cs-muted small mt-4">
            © 2026 Creation Store. All rights reserved.
        </div>
    </div>
</footer>

@code {
    private string Keyword { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        UserStateService.OnChange += HandleUserStateChanged;
        CartStateService.OnChange += HandleCartStateChanged;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UserStateService.GetProfileAsync();
        }
    }

    private void HandleUserStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (UserStateService.IsAuthenticated)
            {
                await CartStateService.LoadCartAsync(showLoading: false);
            }

            StateHasChanged();
        });
    }

    private void HandleCartStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string FormatCurrency(decimal price)
    {
        return price.ToString("#,##0") + "đ";
    }

    private async Task HandleLogout()
    {
        await UserStateService.LogoutAsync();
    }

    private void HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(Keyword))
        {
            NavigationManager.NavigateTo("/products");
            return;
        }

        var keyword = Uri.EscapeDataString(Keyword.Trim());

        NavigationManager.NavigateTo($"/products?keyword={keyword}");
    }

    public void Dispose()
    {
        UserStateService.OnChange -= HandleUserStateChanged;
        CartStateService.OnChange -= HandleCartStateChanged;
    }
}