@page "/"
@page "/products"

@using CreationStore.Blazor.DTOs.Products
@using CreationStore.Blazor.Services

@implements IDisposable

@inject ProductStateService ProductStateService
@inject UserStateService UserStateService
@inject CartStateService CartStateService
@inject NavigationManager NavigationManager

<PageTitle>Creation Store</PageTitle>

<section class="mb-4">
    <div class="cs-card p-4 p-md-5">
        <div class="row align-items-center g-4">
            <div class="col-md-7">
                <span class="badge cs-badge-cart mb-3">
                    Digital Products
                </span>

                <h1 class="fw-bold mb-3">
                    Creation Store
                </h1>

                <p class="cs-muted mb-4">
                    Buy digital products quickly and securely with VNPAY payment support.
                </p>

                <button type="button" class="btn cs-btn-primary px-4" @onclick="ScrollToProducts">
                    View Products
                </button>
            </div>

            <div class="col-md-5 text-center">
                <i class="fas fa-store fa-6x" style="color:#753041"></i>
            </div>
        </div>
    </div>
</section>

<section id="product-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-1">
                Products
            </h2>

            <p class="cs-muted mb-0">
                @if (string.IsNullOrWhiteSpace(Keyword))
                {
                    <span>Browse our available products.</span>
                }
                else
                {
                    <span>
                        Search results for:
                        <strong>@Keyword</strong>
                    </span>
                }
            </p>
        </div>

        <button type="button" class="btn cs-btn-outline" @onclick="ReloadProducts">
            Reload
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(CartStateService.ErrorMessage))
    {
        <div class="alert alert-danger">
            @CartStateService.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(CartStateService.SuccessMessage))
    {
        <div class="alert alert-success">
            @CartStateService.SuccessMessage
        </div>
    }

    @if (ProductStateService.IsLoading)
    {
        <div class="cs-card p-5 text-center">
            <div class="spinner-border text-light mb-3"></div>

            <p class="cs-muted mb-0">
                Loading products...
            </p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ProductStateService.ErrorMessage))
    {
        <div class="alert alert-danger">
            @ProductStateService.ErrorMessage
        </div>
    }
    else if (ProductStateService.Products.Count == 0)
    {
        <div class="cs-card p-5 text-center">
            <h5>No products found</h5>

            <p class="cs-muted mb-0">
                No matching products were found.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (ProductResponseDTO product in ProductStateService.Products)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="cs-card h-100 overflow-hidden d-flex flex-column">

                        <div class="ratio ratio-16x9 bg-dark">
                            <img src="@GetImageUrl(product.ImageUrl)" class="w-100 h-100" style="object-fit: cover;"
                                 alt="@product.ProductName" />
                        </div>

                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <div class="mb-2">
                                <span class="badge cs-badge-cart">
                                    @product.CategoryName
                                </span>
                            </div>

                            <h6 class="fw-semibold mb-2 text-truncate" title="@product.ProductName">
                                @product.ProductName
                            </h6>

                            <p class="cs-muted small mb-3" style="height: 40px; overflow: hidden;">
                                @product.Description
                            </p>

                            <div class="mt-auto">
                                <div class="fw-bold fs-5">
                                    @FormatCurrency(product.Price)
                                </div>

                                <div class="cs-muted small">
                                    @GetValidityText(product.ValidityDays)
                                </div>

                                <div class="d-flex mt-3 cs-product-actions">
                                    <button type="button" class="btn cs-btn-detail flex-fill"
                                            @onclick="() => GoToDetail(product.ProductId)">
                                        View Detail
                                    </button>

                                    <button type="button" class="btn cs-btn-cart flex-fill"
                                            disabled="@CartStateService.IsLoading"
                                            @onclick="() => HandleAddToCart(product.ProductId)">
                                        @if (AddingProductId == product.ProductId &&
                                             CartStateService.IsLoading)
                                        {
                                            <span>Adding...</span>
                                        }
                                        else
                                        {
                                            <span>Add to Cart</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Keyword { get; set; }

    private int? AddingProductId { get; set; }

    protected override void OnInitialized()
    {
        ProductStateService.OnChange += HandleProductStateChanged;
        CartStateService.OnChange += HandleCartStateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await ProductStateService.LoadProductsAsync(Keyword);
    }

    private void HandleProductStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleCartStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ReloadProducts()
    {
        await ProductStateService.LoadProductsAsync(Keyword);
    }

    private void GoToDetail(int productId)
    {
        NavigationManager.NavigateTo($"/products/{productId}");
    }

    private async Task HandleAddToCart(int productId)
    {
        if (!UserStateService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        AddingProductId = productId;

        try
        {
            await CartStateService.AddToCartAsync(productId, 1);
        }
        finally
        {
            AddingProductId = null;
        }
    }

    private void ScrollToProducts()
    {
        NavigationManager.NavigateTo("/#product-section");
    }

    private static string FormatCurrency(decimal price)
    {
        return price.ToString("#,##0") + "đ";
    }

    private static string GetValidityText(int? validityDays)
    {
        if (validityDays.HasValue)
        {
            return $"{validityDays.Value} days";
        }

        return "Lifetime";
    }

    private static string GetImageUrl(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl) ||
            imageUrl.Equals("string", StringComparison.OrdinalIgnoreCase))
        {
            return "https://via.placeholder.com/400x220?text=No+Image";
        }

        if (imageUrl.StartsWith("http://") ||
            imageUrl.StartsWith("https://"))
        {
            return imageUrl;
        }

        if (imageUrl.StartsWith("/"))
        {
            return imageUrl;
        }

        return $"/images/{imageUrl}";
    }

    public void Dispose()
    {
        ProductStateService.OnChange -= HandleProductStateChanged;
        CartStateService.OnChange -= HandleCartStateChanged;
    }
}