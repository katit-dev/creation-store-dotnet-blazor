@page "/"
@page "/products"

@using CreationStore.Blazor.DTOs.Products
@using CreationStore.Blazor.Services

@implements IDisposable

@inject ProductStateService ProductStateService
@inject NavigationManager NavigationManager

<PageTitle>Creation Store</PageTitle>

<section class="mb-4">
    <div class="cs-card p-4 p-md-5">
        <div class="row align-items-center g-4">
            <div class="col-md-7">
                <span class="badge cs-badge-cart mb-3">
                    Digital Products
                </span>

                <h1 class="fw-bold mb-3">
                    Creation Store
                </h1>

                <p class="cs-muted mb-4">
                    Mua sản phẩm số nhanh chóng, an toàn, hỗ trợ thanh toán VNPAY.
                </p>

                <button class="btn cs-btn-primary px-4"
                        @onclick="ScrollToProducts">
                    Xem sản phẩm
                </button>
            </div>

            <div class="col-md-5 text-center">
                <i class="fas fa-store fa-6x"
                   style="color:#753041"></i>
            </div>
        </div>
    </div>
</section>

<section id="product-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold mb-1">
                Sản phẩm
            </h2>

            <p class="cs-muted mb-0">
                @if (string.IsNullOrWhiteSpace(Keyword))
                {
                    <span>Danh sách sản phẩm hiện có.</span>
                }
                else
                {
                    <span>
                        Kết quả tìm kiếm cho:
                        <strong>@Keyword</strong>
                    </span>
                }
            </p>
        </div>

        <button class="btn cs-btn-outline"
                @onclick="ReloadProducts">
            <i class="fas fa-sync-alt me-1"></i>
            Tải lại
        </button>
    </div>

    @if (ProductStateService.IsLoading)
    {
        <div class="cs-card p-5 text-center">
            <div class="spinner-border text-light mb-3"></div>
            <p class="cs-muted mb-0">
                Đang tải sản phẩm...
            </p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ProductStateService.ErrorMessage))
    {
        <div class="alert alert-danger">
            @ProductStateService.ErrorMessage
        </div>
    }
    else if (ProductStateService.Products.Count == 0)
    {
        <div class="cs-card p-5 text-center">
            <h5>Không có sản phẩm</h5>
            <p class="cs-muted mb-0">
                Không tìm thấy sản phẩm phù hợp.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (ProductResponseDTO product in ProductStateService.Products)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="cs-card h-100 overflow-hidden">

                        <a href="@($"/products/{product.ProductId}")"
                           class="text-decoration-none text-white">

                            <div class="ratio ratio-16x9 bg-dark">
                                <img src="@GetImageUrl(product.ImageUrl)"
                                     class="w-100 h-100"
                                     style="object-fit: cover;"
                                     alt="@product.ProductName" />
                            </div>

                            <div class="p-3">
                                <div class="mb-2">
                                    <span class="badge cs-badge-cart">
                                        @product.CategoryName
                                    </span>
                                </div>

                                <h6 class="fw-semibold mb-2 text-truncate"
                                    title="@product.ProductName">
                                    @product.ProductName
                                </h6>

                                <p class="cs-muted small mb-3"
                                   style="height: 40px; overflow: hidden;">
                                    @product.Description
                                </p>

                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold fs-5">
                                            @FormatCurrency(product.Price)
                                        </div>

                                        @if (product.ValidityDays.HasValue)
                                        {
                                            <div class="cs-muted small">
                                                @product.ValidityDays ngày
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="cs-muted small">
                                                Vĩnh viễn
                                            </div>
                                        }
                                    </div>

                                    <button class="btn cs-btn-primary btn-sm"
                                            @onclick="() => GoToDetail(product.ProductId)"
                                            @onclick:preventDefault="true">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>
                        </a>

                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery]
    public string? Keyword { get; set; }

    protected override void OnInitialized()
    {
        ProductStateService.OnChange += HandleProductStateChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await ProductStateService.LoadProductsAsync(Keyword);
    }

    private void HandleProductStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ReloadProducts()
    {
        await ProductStateService.LoadProductsAsync(Keyword);
    }

    private void GoToDetail(int productId)
    {
        NavigationManager.NavigateTo($"/products/{productId}");
    }

    private void ScrollToProducts()
    {
        NavigationManager.NavigateTo("/#product-section");
    }

    private static string FormatCurrency(decimal price)
    {
        return price.ToString("#,##0") + "đ";
    }

    private static string GetImageUrl(string? imageUrl)
{
    if (string.IsNullOrWhiteSpace(imageUrl) ||
        imageUrl.Equals("string", StringComparison.OrdinalIgnoreCase))
    {
        return "https://via.placeholder.com/400x220?text=No+Image";
    }

    if (imageUrl.StartsWith("http://") ||
        imageUrl.StartsWith("https://"))
    {
        return imageUrl;
    }

    if (imageUrl.StartsWith("/"))
    {
        return imageUrl;
    }

    return $"/images/{imageUrl}";
}

    public void Dispose()
    {
        ProductStateService.OnChange -= HandleProductStateChanged;
    }
}