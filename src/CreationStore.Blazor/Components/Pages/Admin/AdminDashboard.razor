@page "/admin/dashboard"

@using CreationStore.Blazor.Components.Shared

<PageTitle>Admin Dashboard</PageTitle>

<AdminGuard>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Admin Dashboard
            </h2>

            <p class="cs-muted mb-0">
                Manage store performance, orders, products and users.
            </p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="cs-card p-4">
                <div class="cs-muted small">
                    Dashboard
                </div>

                <h4 class="fw-bold mt-2 mb-0">
                    Ready
                </h4>

                <p class="cs-muted small mt-2 mb-0">
                    Dashboard data will be implemented in the next step.
                </p>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="cs-card p-4">
                <div class="cs-muted small">
                    Products
                </div>

                <h4 class="fw-bold mt-2 mb-0">
                    Manage
                </h4>

                <p class="cs-muted small mt-2 mb-0">
                    Product management will be implemented later.
                </p>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="cs-card p-4">
                <div class="cs-muted small">
                    Orders
                </div>

                <h4 class="fw-bold mt-2 mb-0">
                    Track
                </h4>

                <p class="cs-muted small mt-2 mb-0">
                    Order management will be implemented later.
                </p>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="cs-card p-4">
                <div class="cs-muted small">
                    Users
                </div>

                <h4 class="fw-bold mt-2 mb-0">
                    Control
                </h4>

                <p class="cs-muted small mt-2 mb-0">
                    User management will be implemented later.
                </p>
            </div>
        </div>
    </div>
</AdminGuard>