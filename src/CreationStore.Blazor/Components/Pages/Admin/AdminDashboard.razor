@page "/admin/dashboard"
@layout AdminLayout

@using CreationStore.Blazor.DTOs.Admin.Dashboard
@using CreationStore.Blazor.Services

@implements IDisposable

@inject UserStateService UserStateService
@inject AdminDashboardStateService AdminDashboardStateService
@inject NavigationManager NavigationManager

<PageTitle>Admin Dashboard</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            Dashboard Overview
        </h2>

        <p class="cs-muted mb-0">
            Monitor revenue, orders, products and recent activities.
        </p>
    </div>

    <button type="button" class="btn cs-btn-outline" @onclick="ReloadDashboard">
        Reload
    </button>
</div>

<div class="cs-card p-3 p-md-4 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label">
                From date
            </label>

            <InputDate class="form-control cs-input" @bind-Value="FromDate" />
        </div>

        <div class="col-12 col-md-4">
            <label class="form-label">
                To date
            </label>

            <InputDate class="form-control cs-input" @bind-Value="ToDate" />
        </div>

        <div class="col-12 col-md-4">
            <button type="button" class="btn cs-btn-cart w-100" disabled="@AdminDashboardStateService.IsLoading"
                    @onclick="ReloadDashboard">
                Apply Filter
            </button>
        </div>
    </div>
</div>

@if (AdminDashboardStateService.IsLoading)
{
    <div class="cs-card p-5 text-center">
        <div class="spinner-border text-light mb-3"></div>

        <p class="cs-muted mb-0">
            Loading dashboard...
        </p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(AdminDashboardStateService.ErrorMessage))
{
    <div class="alert alert-danger">
        @AdminDashboardStateService.ErrorMessage
    </div>
}
else
{
    AdminDashboardSummaryDTO summary =
        AdminDashboardStateService.Summary ?? new AdminDashboardSummaryDTO();

    <div class="row g-4 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="cs-card cs-admin-stat-card p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="cs-muted small">
                            Total Revenue
                        </div>

                        <h3 class="fw-bold mt-2 mb-0">
                            @FormatCurrency(summary.TotalRevenue)
                        </h3>
                    </div>

                    <div class="cs-admin-stat-icon">
                        $
                    </div>
                </div>

                <p class="cs-muted small mt-3 mb-0">
                    Revenue from succeeded payments.
                </p>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="cs-card cs-admin-stat-card p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="cs-muted small">
                            Total Orders
                        </div>

                        <h3 class="fw-bold mt-2 mb-0">
                            @summary.TotalOrders
                        </h3>
                    </div>

                    <div class="cs-admin-stat-icon">
                        O
                    </div>
                </div>

                <p class="cs-muted small mt-3 mb-0">
                    All customer orders.
                </p>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="cs-card cs-admin-stat-card p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="cs-muted small">
                            Total Products
                        </div>

                        <h3 class="fw-bold mt-2 mb-0">
                            @summary.TotalProducts
                        </h3>
                    </div>

                    <div class="cs-admin-stat-icon">
                        P
                    </div>
                </div>

                <p class="cs-muted small mt-3 mb-0">
                    Products in store.
                </p>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-3">
            <div class="cs-card cs-admin-stat-card p-4">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="cs-muted small">
                            Total Users
                        </div>

                        <h3 class="fw-bold mt-2 mb-0">
                            @summary.TotalUsers
                        </h3>
                    </div>

                    <div class="cs-admin-stat-icon">
                        U
                    </div>
                </div>

                <p class="cs-muted small mt-3 mb-0">
                    Registered accounts.
                </p>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-md-3">
            <div class="cs-card p-3">
                <div class="cs-muted small">
                    Pending Payment
                </div>

                <h4 class="fw-bold mt-2 mb-0">
                    @summary.PendingPaymentOrders
                </h4>
            </div>
        </div>

        <div class="col-12 col-md-3">
            <div class="cs-card p-3">
                <div class="cs-muted small">
                    Paid Orders
                </div>

                <h4 class="fw-bold mt-2 mb-0">
                    @summary.PaidOrders
                </h4>
            </div>
        </div>

        <div class="col-12 col-md-3">
            <div class="cs-card p-3">
                <div class="cs-muted small">
                    Completed Orders
                </div>

                <h4 class="fw-bold mt-2 mb-0">
                    @summary.CompletedOrders
                </h4>
            </div>
        </div>

        <div class="col-12 col-md-3">
            <div class="cs-card p-3">
                <div class="cs-muted small">
                    Cancelled Orders
                </div>

                <h4 class="fw-bold mt-2 mb-0">
                    @summary.CancelledOrders
                </h4>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-xl-7">
            <div class="cs-card p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold mb-0">
                        Revenue
                    </h4>

                    <span class="cs-muted small">
                        @FormatDateOnly(FromDate) - @FormatDateOnly(ToDate)
                    </span>
                </div>

                @if (AdminDashboardStateService.RevenueItems.Count == 0)
                {
                    <p class="cs-muted mb-0">
                        No revenue data for this date range.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0 cs-order-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th class="text-end">Orders</th>
                                    <th class="text-end">Revenue</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (AdminRevenueDTO item in AdminDashboardStateService.RevenueItems)
                                {
                                    <tr>
                                        <td>@FormatDateOnly(item.DisplayDate)</td>

                                        <td class="text-end">
                                            @item.DisplayOrderCount
                                        </td>

                                        <td class="text-end fw-semibold">
                                            @FormatCurrency(item.DisplayRevenue)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="cs-card p-4 h-100">
                <h4 class="fw-bold mb-4">
                    Order Status
                </h4>

                <div class="cs-admin-donut-wrap">
                    <div class="cs-admin-donut">
                        <div class="cs-admin-donut-center">
                            <div class="fw-bold fs-4">
                                @summary.TotalOrders
                            </div>

                            <div class="cs-muted small">
                                Orders
                            </div>
                        </div>
                    </div>

                    <div class="cs-admin-donut-legend">
                        <div class="d-flex justify-content-between mb-3">
                            <span class="cs-muted">Pending Payment</span>
                            <span>@summary.PendingPaymentOrders</span>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="cs-muted">Paid</span>
                            <span>@summary.PaidOrders</span>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="cs-muted">Completed</span>
                            <span>@summary.CompletedOrders</span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <span class="cs-muted">Cancelled</span>
                            <span>@summary.CancelledOrders</span>
                        </div>
                    </div>
                </div>

                <p class="cs-muted small mt-4 mb-0">
                    Status overview based on current orders.
                </p>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-xl-6">
            <div class="cs-card p-4 h-100">
                <h4 class="fw-bold mb-4">
                    Top Products
                </h4>

                @if (AdminDashboardStateService.TopProducts.Count == 0)
                {
                    <p class="cs-muted mb-0">
                        No top product data.
                    </p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle mb-0 cs-order-table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Sold</th>
                                    <th class="text-end">Revenue</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (AdminTopProductDTO product in AdminDashboardStateService.TopProducts)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">
                                                @product.ProductName
                                            </div>

                                            <div class="cs-muted small">
                                                Product ID: @product.ProductId
                                            </div>
                                        </td>

                                        <td class="text-end">
                                            @product.DisplayQuantitySold
                                        </td>

                                        <td class="text-end fw-semibold">
                                            @FormatCurrency(product.DisplayRevenue)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="col-12 col-xl-6">
            <div class="cs-card p-4 h-100">
                <h4 class="fw-bold mb-4">
                    Payment Summary
                </h4>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="cs-info-box">
                            <div class="cs-muted small">
                                Succeeded Payments
                            </div>

                            <h4 class="fw-bold mt-2 mb-0">
                                @summary.SucceededPayments
                            </h4>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="cs-info-box">
                            <div class="cs-muted small">
                                Failed Payments
                            </div>

                            <h4 class="fw-bold mt-2 mb-0">
                                @summary.FailedPayments
                            </h4>
                        </div>
                    </div>
                </div>

                <p class="cs-muted small mt-4 mb-0">
                    Payment statistics are based on payment transaction records.
                </p>
            </div>
        </div>
    </div>

    <div class="cs-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0">
                Recent Orders
            </h4>

            <button type="button" class="btn cs-btn-cart" @onclick="GoToAdminOrders">
                View All Orders
            </button>
        </div>

        @if (AdminDashboardStateService.RecentOrders.Count == 0)
        {
            <p class="cs-muted mb-0">
                No recent orders.
            </p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0 cs-order-table">
                    <thead>
                        <tr>
                            <th>Order</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Order Status</th>
                            <th>Payment Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (AdminRecentOrderDTO order in AdminDashboardStateService.RecentOrders)
                        {
                            <tr>
                                <td>
                                    <span class="fw-semibold">
                                        #@order.OrderId
                                    </span>
                                </td>

                                <td>
                                    @DisplayText(order.DisplayCustomerName)
                                </td>

                                <td>
                                    @FormatDate(order.OrderDate)
                                </td>

                                <td class="fw-semibold">
                                    @FormatCurrency(order.TotalAmount)
                                </td>

                                <td>
                                    <span class="@GetOrderStatusClass(order.Status)">
                                        @order.Status
                                    </span>
                                </td>

                                <td>
                                    <span class="@GetPaymentStatusClass(order.PaymentStatus)">
                                        @order.PaymentStatus
                                    </span>
                                </td>

                                <td class="text-end">
                                    <button type="button" class="btn cs-btn-detail btn-sm"
                                            @onclick="() => GoToAdminOrderDetail(order.OrderId)">
                                        View Detail
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private DateTime FromDate { get; set; } =
        new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1);

    private DateTime ToDate { get; set; } = DateTime.Now;

    protected override void OnInitialized()
    {
        AdminDashboardStateService.OnChange += HandleDashboardStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UserStateService.GetProfileAsync();

            if (UserStateService.IsAuthenticated && UserStateService.IsAdmin)
            {
                await AdminDashboardStateService.LoadDashboardAsync(
                    FromDate,
                    ToDate
                );
            }
        }
    }

    private void HandleDashboardStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ReloadDashboard()
    {
        await AdminDashboardStateService.LoadDashboardAsync(
            FromDate,
            ToDate
        );
    }

    private void GoToAdminOrders()
    {
        NavigationManager.NavigateTo("/admin/orders");
    }

    private void GoToAdminOrderDetail(int orderId)
    {
        NavigationManager.NavigateTo($"/admin/orders/{orderId}");
    }

    private static string FormatCurrency(decimal price)
    {
        return price.ToString("#,##0") + "đ";
    }

    private static string FormatDate(DateTime dateTime)
    {
        return dateTime.ToString("dd/MM/yyyy HH:mm");
    }

    private static string FormatDateOnly(DateTime dateTime)
    {
        if (dateTime == default)
        {
            return "-";
        }

        return dateTime.ToString("dd/MM/yyyy");
    }

    private static string DisplayText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        return value;
    }

    private static string GetOrderStatusClass(string status)
    {
        var baseClass = "badge cs-status-badge ";

        return status.ToLower() switch
        {
            "pendingpayment" => baseClass + "cs-status-warning",
            "paid" => baseClass + "cs-status-success",
            "completed" => baseClass + "cs-status-success",
            "cancelled" => baseClass + "cs-status-danger",
            _ => baseClass + "cs-status-muted"
        };
    }

    private static string GetPaymentStatusClass(string status)
    {
        var baseClass = "badge cs-status-badge ";

        return status.ToLower() switch
        {
            "pending" => baseClass + "cs-status-warning",
            "succeeded" => baseClass + "cs-status-success",
            "failed" => baseClass + "cs-status-danger",
            "cancelled" => baseClass + "cs-status-danger",
            _ => baseClass + "cs-status-muted"
        };
    }

    public void Dispose()
    {
        AdminDashboardStateService.OnChange -= HandleDashboardStateChanged;
    }
}