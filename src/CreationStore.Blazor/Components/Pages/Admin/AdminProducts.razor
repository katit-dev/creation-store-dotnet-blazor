@page "/admin/products"
@layout AdminLayout

@using CreationStore.Blazor.DTOs.Products
@using CreationStore.Blazor.Services

@implements IDisposable

@inject AdminProductStateService AdminProductStateService
@inject NavigationManager NavigationManager

<PageTitle>Admin Products</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            Products
        </h2>

        <p class="cs-muted mb-0">
            Manage product list, pricing, categories and validity.
        </p>
    </div>

    <button type="button"
            class="btn cs-btn-outline"
            @onclick="ReloadProducts">
        Reload
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(AdminProductStateService.ErrorMessage))
{
    <div class="alert alert-danger">
        @AdminProductStateService.ErrorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(AdminProductStateService.SuccessMessage))
{
    <div class="alert alert-success">
        @AdminProductStateService.SuccessMessage
    </div>
}

<div class="row g-4">
    <div class="col-12 col-xl-4">
        <div class="cs-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h4 class="fw-bold mb-1">
                        @(IsEditMode ? "Edit Product" : "Create Product")
                    </h4>

                    <p class="cs-muted mb-0">
                        @(IsEditMode ? "Update selected product information." : "Add a new digital product.")
                    </p>
                </div>
            </div>

            <EditForm Model="ProductForm"
                      OnValidSubmit="SaveProductAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">
                        Product Name
                    </label>

                    <InputText class="form-control cs-input"
                               placeholder="Enter product name"
                               @bind-Value="ProductForm.ProductName" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Description
                    </label>

                    <InputTextArea class="form-control cs-input"
                                   rows="3"
                                   placeholder="Enter description"
                                   @bind-Value="ProductForm.Description" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Price
                    </label>

                    <InputNumber class="form-control cs-input"
                                 @bind-Value="ProductForm.Price" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Image URL
                    </label>

                    <InputText class="form-control cs-input"
                               placeholder="/images/example.png"
                               @bind-Value="ProductForm.ImageUrl" />
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label">
                            Validity Days
                        </label>

                        <InputNumber class="form-control cs-input"
                                     @bind-Value="ProductForm.ValidityDays" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">
                            Category ID
                        </label>

                        <InputNumber class="form-control cs-input"
                                     @bind-Value="ProductForm.CategoryId" />
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit"
                            class="btn cs-btn-cart"
                            disabled="@AdminProductStateService.IsLoading">
                        @(IsEditMode ? "Save Changes" : "Create Product")
                    </button>

                    @if (IsEditMode)
                    {
                        <button type="button"
                                class="btn cs-btn-outline"
                                disabled="@AdminProductStateService.IsLoading"
                                @onclick="CancelEdit">
                            Cancel
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="btn cs-btn-outline"
                                disabled="@AdminProductStateService.IsLoading"
                                @onclick="ResetForm">
                            Reset
                        </button>
                    }
                </div>
            </EditForm>
        </div>
    </div>

    <div class="col-12 col-xl-8">
        <div class="cs-card p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
                <div>
                    <h4 class="fw-bold mb-1">
                        Product List
                    </h4>

                    <p class="cs-muted mb-0">
                        @FilteredProducts.Count product(s) found.
                    </p>
                </div>

                <div class="admin-product-search">
                    <input class="form-control cs-input"
                           placeholder="Search products..."
                           @bind="Keyword"
                           @bind:event="oninput" />
                </div>
            </div>

            @if (AdminProductStateService.IsLoading)
            {
                <div class="p-5 text-center">
                    <div class="spinner-border text-light mb-3"></div>

                    <p class="cs-muted mb-0">
                        Loading products...
                    </p>
                </div>
            }
            else if (FilteredProducts.Count == 0)
            {
                <div class="p-5 text-center">
                    <h5>No products found</h5>

                    <p class="cs-muted mb-0">
                        Try changing your search keyword.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0 cs-order-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th class="text-end">Price</th>
                                <th class="text-center">Validity</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (ProductResponseDTO product in FilteredProducts)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@GetImageUrl(product.ImageUrl)"
                                                 class="admin-product-thumb"
                                                 alt="@product.ProductName" />

                                            <div>
                                                <div class="fw-semibold">
                                                    @product.ProductName
                                                </div>

                                                <div class="cs-muted small">
                                                    ID: @product.ProductId
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge cs-badge-cart">
                                            @product.CategoryName
                                        </span>

                                        <div class="cs-muted small mt-1">
                                            Category ID: @product.CategoryId
                                        </div>
                                    </td>

                                    <td class="text-end fw-semibold">
                                        @FormatCurrency(product.Price)
                                    </td>

                                    <td class="text-center">
                                        @if (product.ValidityDays.HasValue)
                                        {
                                            <span>@product.ValidityDays days</span>
                                        }
                                        else
                                        {
                                            <span>Lifetime</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button"
                                                    class="btn cs-btn-detail btn-sm"
                                                    @onclick="() => StartEdit(product)">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="btn cs-btn-outline btn-sm"
                                                    @onclick="() => DeleteProductAsync(product.ProductId)">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private ProductCreateDTO ProductForm { get; set; } = new();

    private int? EditingProductId { get; set; }

    private bool IsEditMode => EditingProductId.HasValue;

    private string Keyword { get; set; } = string.Empty;

    private List<ProductResponseDTO> FilteredProducts
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Keyword))
            {
                return AdminProductStateService.Products;
            }

            var keyword = Keyword.Trim();

            return AdminProductStateService.Products
                .Where(product =>
                    product.ProductName.Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase
                    ) ||
                    product.CategoryName.Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase
                    )
                )
                .ToList();
        }
    }

    protected override void OnInitialized()
    {
        AdminProductStateService.OnChange += HandleProductStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AdminProductStateService.LoadProductsAsync();
        }
    }

    private void HandleProductStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ReloadProducts()
    {
        await AdminProductStateService.LoadProductsAsync();
    }

    private async Task SaveProductAsync()
    {
        if (IsEditMode && EditingProductId.HasValue)
        {
            var updateDto = new ProductUpdateDTO
            {
                ProductName = ProductForm.ProductName,
                Description = ProductForm.Description,
                Price = ProductForm.Price,
                ImageUrl = ProductForm.ImageUrl,
                ValidityDays = ProductForm.ValidityDays,
                CategoryId = ProductForm.CategoryId
            };

            var success = await AdminProductStateService.UpdateProductAsync(
                EditingProductId.Value,
                updateDto
            );

            if (success)
            {
                ResetForm();
            }

            return;
        }

        var created = await AdminProductStateService.CreateProductAsync(
            ProductForm
        );

        if (created)
        {
            ResetForm();
        }
    }

    private void StartEdit(ProductResponseDTO product)
    {
        EditingProductId = product.ProductId;

        ProductForm = new ProductCreateDTO
        {
            ProductName = product.ProductName,
            Description = product.Description,
            Price = product.Price,
            ImageUrl = product.ImageUrl,
            ValidityDays = product.ValidityDays,
            CategoryId = product.CategoryId
        };
    }

    private void CancelEdit()
    {
        ResetForm();
    }

    private void ResetForm()
    {
        EditingProductId = null;

        ProductForm = new ProductCreateDTO
        {
            ProductName = string.Empty,
            Description = string.Empty,
            Price = 0,
            ImageUrl = string.Empty,
            ValidityDays = null,
            CategoryId = 1
        };
    }

    private async Task DeleteProductAsync(int productId)
    {
        await AdminProductStateService.DeleteProductAsync(productId);

        if (EditingProductId == productId)
        {
            ResetForm();
        }
    }

    private static string FormatCurrency(decimal price)
    {
        return price.ToString("#,##0") + "đ";
    }

    private static string GetImageUrl(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl) ||
            imageUrl.Equals("string", StringComparison.OrdinalIgnoreCase))
        {
            return "https://via.placeholder.com/120x80?text=No+Image";
        }

        if (imageUrl.StartsWith("http://") ||
            imageUrl.StartsWith("https://"))
        {
            return imageUrl;
        }

        if (imageUrl.StartsWith("/"))
        {
            return imageUrl;
        }

        return $"/images/{imageUrl}";
    }

    public void Dispose()
    {
        AdminProductStateService.OnChange -= HandleProductStateChanged;
    }
}