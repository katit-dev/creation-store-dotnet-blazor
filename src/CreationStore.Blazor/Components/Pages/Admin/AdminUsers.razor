@page "/admin/users"
@layout AdminLayout

@using CreationStore.Blazor.Components.Layout
@using CreationStore.Blazor.DTOs.Admin.Users
@using CreationStore.Blazor.Services

@implements IDisposable

@inject AdminUserStateService AdminUserStateService

<PageTitle>Admin Users</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            Users
        </h2>

        <p class="cs-muted mb-0">
            Manage user accounts, roles and account status.
        </p>
    </div>

    <button type="button"
            class="btn cs-btn-outline"
            @onclick="ReloadUsers">
        Reload
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(AdminUserStateService.ErrorMessage))
{
    <div class="alert alert-danger">
        @AdminUserStateService.ErrorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(AdminUserStateService.SuccessMessage))
{
    <div class="alert alert-success">
        @AdminUserStateService.SuccessMessage
    </div>
}

<div class="cs-card p-4 mb-4">
    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label class="form-label">
                Search
            </label>

            <input class="form-control cs-input"
                   placeholder="Search username, email, phone or full name..."
                   @bind="Keyword"
                   @bind:event="oninput" />
        </div>

        <div class="col-12 col-md-3">
            <label class="form-label">
                Role
            </label>

            <select class="form-control cs-input"
                    @bind="SelectedRole">
                <option value="">All roles</option>
                <option value="Admin">Admin</option>
                <option value="Member">Member</option>
            </select>
        </div>

        <div class="col-12 col-md-3">
            <label class="form-label">
                Status
            </label>

            <select class="form-control cs-input"
                    @bind="SelectedStatus">
                <option value="">All statuses</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
        </div>
    </div>
</div>

<div class="cs-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">
                User List
            </h4>

            <p class="cs-muted mb-0">
                @FilteredUsers.Count user(s) found.
            </p>
        </div>
    </div>

    @if (AdminUserStateService.IsLoading)
    {
        <div class="p-5 text-center">
            <div class="spinner-border text-light mb-3"></div>

            <p class="cs-muted mb-0">
                Loading users...
            </p>
        </div>
    }
    else if (FilteredUsers.Count == 0)
    {
        <div class="p-5 text-center">
            <h5>No users found</h5>

            <p class="cs-muted mb-0">
                Try changing your filters.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0 cs-order-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Contact</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (AdminUserResponseDTO user in FilteredUsers)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="admin-user-avatar">
                                        @GetAvatarText(user)
                                    </div>

                                    <div>
                                        <div class="fw-semibold">
                                            @user.Username
                                        </div>

                                        <div class="cs-muted small">
                                            @DisplayText(user.FullName)
                                        </div>

                                        <div class="cs-muted small">
                                            ID: @user.UserId
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div>
                                    @DisplayText(user.Email)
                                </div>

                                <div class="cs-muted small">
                                    @DisplayText(user.Phone)
                                </div>
                            </td>

                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    @if (user.Roles.Count == 0)
                                    {
                                        <span class="cs-muted small">
                                            No role
                                        </span>
                                    }
                                    else
                                    {
                                        @foreach (string role in user.Roles)
                                        {
                                            <span class="badge cs-badge-cart">
                                                @role
                                            </span>
                                        }
                                    }
                                </div>
                            </td>

                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge cs-status-badge cs-status-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge cs-status-badge cs-status-danger">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td>
                                @user.CreatedAt.ToString("dd/MM/yyyy")
                            </td>

                            <td class="text-end">
                                @if (user.IsActive)
                                {
                                    <button type="button"
                                            class="btn cs-btn-outline btn-sm"
                                            disabled="@AdminUserStateService.IsLoading"
                                            @onclick="() => DeactivateUserAsync(user.UserId)">
                                        Deactivate
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn cs-btn-cart btn-sm"
                                            disabled="@AdminUserStateService.IsLoading"
                                            @onclick="() => ActivateUserAsync(user.UserId)">
                                        Activate
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private string Keyword { get; set; } = string.Empty;

    private string SelectedRole { get; set; } = string.Empty;

    private string SelectedStatus { get; set; } = string.Empty;

    private List<AdminUserResponseDTO> FilteredUsers
    {
        get
        {
            IEnumerable<AdminUserResponseDTO> query = AdminUserStateService.Users;

            if (!string.IsNullOrWhiteSpace(Keyword))
            {
                var keyword = Keyword.Trim();

                query = query.Where(user =>
                    TextContains(user.Username, keyword) ||
                    TextContains(user.FullName, keyword) ||
                    TextContains(user.Email, keyword) ||
                    TextContains(user.Phone, keyword) ||
                    user.UserId.ToString().Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase
                    )
                );
            }

            if (!string.IsNullOrWhiteSpace(SelectedRole))
            {
                query = query.Where(user =>
                    user.Roles.Any(role =>
                        string.Equals(
                            role,
                            SelectedRole,
                            StringComparison.OrdinalIgnoreCase
                        )
                    )
                );
            }

            if (!string.IsNullOrWhiteSpace(SelectedStatus))
            {
                var isActive = SelectedStatus.Equals(
                    "Active",
                    StringComparison.OrdinalIgnoreCase
                );

                query = query.Where(user => user.IsActive == isActive);
            }

            return query
                .OrderByDescending(user => user.CreatedAt)
                .ToList();
        }
    }

    protected override void OnInitialized()
    {
        AdminUserStateService.OnChange += HandleUserStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AdminUserStateService.LoadUsersAsync();
        }
    }

    private void HandleUserStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ReloadUsers()
    {
        await AdminUserStateService.LoadUsersAsync();
    }

    private async Task ActivateUserAsync(int userId)
    {
        await AdminUserStateService.ActivateUserAsync(userId);
    }

    private async Task DeactivateUserAsync(int userId)
    {
        await AdminUserStateService.DeactivateUserAsync(userId);
    }

    private static string GetAvatarText(AdminUserResponseDTO user)
    {
        if (!string.IsNullOrWhiteSpace(user.Username))
        {
            return user.Username.Trim()[0].ToString().ToUpper();
        }

        return "U";
    }

    private static string DisplayText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        return value;
    }

    private static bool TextContains(string? value, string keyword)
    {
        return !string.IsNullOrWhiteSpace(value) &&
            value.Contains(keyword, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        AdminUserStateService.OnChange -= HandleUserStateChanged;
    }
}