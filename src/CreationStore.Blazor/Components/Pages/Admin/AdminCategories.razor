@page "/admin/categories"
@layout AdminLayout

@using CreationStore.Blazor.DTOs.Categories
@using CreationStore.Blazor.Services
@using Microsoft.AspNetCore.Components.Forms

@implements IDisposable

@inject AdminCategoryStateService AdminCategoryStateService

<PageTitle>Admin Categories</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            Categories
        </h2>

        <p class="cs-muted mb-0">
            Manage product categories used by digital products.
        </p>
    </div>

    <button type="button"
            class="btn cs-btn-outline"
            @onclick="ReloadCategories">
        Reload
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(AdminCategoryStateService.ErrorMessage))
{
    <div class="alert alert-danger">
        @AdminCategoryStateService.ErrorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(AdminCategoryStateService.SuccessMessage))
{
    <div class="alert alert-success">
        @AdminCategoryStateService.SuccessMessage
    </div>
}

<div class="row g-4">
    <div class="col-12 col-xl-4">
        <div class="cs-card p-4 h-100">
            <div class="mb-4">
                <h4 class="fw-bold mb-1">
                    @(IsEditMode ? "Edit Category" : "Create Category")
                </h4>

                <p class="cs-muted mb-0">
                    @(IsEditMode ? "Update selected category information." : "Add a new product category.")
                </p>
            </div>

            <EditForm EditContext="CategoryEditContext"
                      OnValidSubmit="SaveCategoryAsync">
                <DataAnnotationsValidator />

                @if (HasValidationErrors)
                {
                    <div class="cs-validation-box">
                        <div class="cs-validation-title">
                            Please check the following fields:
                        </div>

                        <ValidationSummary />
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">
                        Category Name
                    </label>

                    <InputText class="form-control cs-input"
                               placeholder="Enter category name"
                               @bind-Value="CategoryForm.CategoryName" />

                    <ValidationMessage For="@(() => CategoryForm.CategoryName)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Description
                    </label>

                    <InputTextArea class="form-control cs-input"
                                   rows="4"
                                   placeholder="Enter description"
                                   @bind-Value="CategoryForm.Description" />
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit"
                            class="btn cs-btn-cart"
                            disabled="@AdminCategoryStateService.IsLoading">
                        @(IsEditMode ? "Save Changes" : "Create Category")
                    </button>

                    @if (IsEditMode)
                    {
                        <button type="button"
                                class="btn cs-btn-outline"
                                disabled="@AdminCategoryStateService.IsLoading"
                                @onclick="CancelEdit">
                            Cancel
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="btn cs-btn-outline"
                                disabled="@AdminCategoryStateService.IsLoading"
                                @onclick="ResetForm">
                            Reset
                        </button>
                    }
                </div>
            </EditForm>
        </div>
    </div>

    <div class="col-12 col-xl-8">
        <div class="cs-card p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
                <div>
                    <h4 class="fw-bold mb-1">
                        Category List
                    </h4>

                    <p class="cs-muted mb-0">
                        @FilteredCategories.Count category/categories found.
                    </p>
                </div>

                <div class="admin-product-search">
                    <input class="form-control cs-input"
                           placeholder="Search categories..."
                           @bind="Keyword"
                           @bind:event="oninput" />
                </div>
            </div>

            @if (AdminCategoryStateService.IsLoading)
            {
                <div class="p-5 text-center">
                    <div class="spinner-border text-light mb-3"></div>

                    <p class="cs-muted mb-0">
                        Loading categories...
                    </p>
                </div>
            }
            else if (FilteredCategories.Count == 0)
            {
                <div class="p-5 text-center">
                    <h5>No categories found</h5>

                    <p class="cs-muted mb-0">
                        Try changing your search keyword.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0 cs-order-table">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Description</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (CategoryResponseDTO category in FilteredCategories)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @category.CategoryName
                                        </div>

                                        <div class="cs-muted small">
                                            ID: @category.CategoryId
                                        </div>
                                    </td>

                                    <td>
                                        @DisplayText(category.Description)
                                    </td>

                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-2">
                                            <button type="button"
                                                    class="btn cs-btn-detail btn-sm"
                                                    @onclick="() => StartEdit(category)">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="btn cs-btn-outline btn-sm"
                                                    @onclick="() => DeleteCategoryAsync(category.CategoryId)">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private CategoryCreateDTO CategoryForm { get; set; } = new();

    private EditContext CategoryEditContext { get; set; } = default!;

    private int? EditingCategoryId { get; set; }

    private bool IsEditMode => EditingCategoryId.HasValue;

    private bool HasValidationErrors { get; set; }

    private string Keyword { get; set; } = string.Empty;

    private List<CategoryResponseDTO> FilteredCategories
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Keyword))
            {
                return AdminCategoryStateService.Categories;
            }

            var keyword = Keyword.Trim();

            return AdminCategoryStateService.Categories
                .Where(category =>
                    category.CategoryName.Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase
                    ) ||
                    (
                        category.Description != null &&
                        category.Description.Contains(
                            keyword,
                            StringComparison.OrdinalIgnoreCase
                        )
                    )
                )
                .ToList();
        }
    }

    protected override void OnInitialized()
    {
        AdminCategoryStateService.OnChange += HandleCategoryStateChanged;

        CreateEditContext();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AdminCategoryStateService.LoadCategoriesAsync();
        }
    }

    private void CreateEditContext()
    {
        CategoryEditContext = new EditContext(CategoryForm);

        CategoryEditContext.OnValidationStateChanged += HandleValidationStateChanged;

        HasValidationErrors = false;
    }

    private void HandleValidationStateChanged(
        object? sender,
        ValidationStateChangedEventArgs e
    )
    {
        HasValidationErrors = CategoryEditContext
            .GetValidationMessages()
            .Any();

        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleCategoryStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ReloadCategories()
    {
        await AdminCategoryStateService.LoadCategoriesAsync();
    }

    private async Task SaveCategoryAsync()
    {
        if (IsEditMode && EditingCategoryId.HasValue)
        {
            var updateDto = new CategoryUpdateDTO
            {
                CategoryName = CategoryForm.CategoryName,
                Description = CategoryForm.Description
            };

            var success = await AdminCategoryStateService.UpdateCategoryAsync(
                EditingCategoryId.Value,
                updateDto
            );

            if (success)
            {
                ResetForm();
            }

            return;
        }

        var created = await AdminCategoryStateService.CreateCategoryAsync(
            CategoryForm
        );

        if (created)
        {
            ResetForm();
        }
    }

    private void StartEdit(CategoryResponseDTO category)
    {
        EditingCategoryId = category.CategoryId;

        CategoryForm = new CategoryCreateDTO
        {
            CategoryName = category.CategoryName,
            Description = category.Description
        };

        CreateEditContext();
    }

    private void CancelEdit()
    {
        ResetForm();
    }

    private void ResetForm()
    {
        EditingCategoryId = null;

        CategoryForm = new CategoryCreateDTO
        {
            CategoryName = string.Empty,
            Description = string.Empty
        };

        CreateEditContext();
    }

    private async Task DeleteCategoryAsync(int categoryId)
    {
        await AdminCategoryStateService.DeleteCategoryAsync(categoryId);

        if (EditingCategoryId == categoryId)
        {
            ResetForm();
        }
    }

    private static string DisplayText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "-";
        }

        return value;
    }

    public void Dispose()
    {
        AdminCategoryStateService.OnChange -= HandleCategoryStateChanged;

        if (CategoryEditContext != null)
        {
            CategoryEditContext.OnValidationStateChanged -= HandleValidationStateChanged;
        }
    }
}