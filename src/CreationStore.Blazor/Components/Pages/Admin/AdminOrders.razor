@page "/admin/orders"
@layout AdminLayout

@using CreationStore.Blazor.DTOs.Orders
@using CreationStore.Blazor.Services

@implements IDisposable

@inject AdminOrderStateService AdminOrderStateService
@inject NavigationManager NavigationManager

<PageTitle>Admin Orders</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            Orders
        </h2>

        <p class="cs-muted mb-0">
            Manage customer orders, payment status and fulfillment.
        </p>
    </div>

    <button type="button"
            class="btn cs-btn-outline"
            @onclick="ReloadOrders">
        Reload
    </button>
</div>

@if (!string.IsNullOrWhiteSpace(AdminOrderStateService.ErrorMessage))
{
    <div class="alert alert-danger">
        @AdminOrderStateService.ErrorMessage
    </div>
}

@if (!string.IsNullOrWhiteSpace(AdminOrderStateService.SuccessMessage))
{
    <div class="alert alert-success">
        @AdminOrderStateService.SuccessMessage
    </div>
}

<div class="cs-card p-4 mb-4">
    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label class="form-label">
                Search
            </label>

            <input class="form-control cs-input"
                   placeholder="Search by order id, status or payment status..."
                   @bind="Keyword"
                   @bind:event="oninput" />
        </div>

        <div class="col-12 col-md-3">
            <label class="form-label">
                Order Status
            </label>

            <select class="form-control cs-input"
                    @bind="SelectedStatus">
                <option value="">All statuses</option>
                <option value="PendingPayment">PendingPayment</option>
                <option value="Paid">Paid</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
            </select>
        </div>

        <div class="col-12 col-md-3">
            <label class="form-label">
                Payment Status
            </label>

            <select class="form-control cs-input"
                    @bind="SelectedPaymentStatus">
                <option value="">All payments</option>
                <option value="Pending">Pending</option>
                <option value="Succeeded">Succeeded</option>
                <option value="Failed">Failed</option>
            </select>
        </div>
    </div>
</div>

<div class="cs-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">
                Order List
            </h4>

            <p class="cs-muted mb-0">
                @FilteredOrders.Count order(s) found.
            </p>
        </div>
    </div>

    @if (AdminOrderStateService.IsLoading)
    {
        <div class="p-5 text-center">
            <div class="spinner-border text-light mb-3"></div>

            <p class="cs-muted mb-0">
                Loading orders...
            </p>
        </div>
    }
    else if (FilteredOrders.Count == 0)
    {
        <div class="p-5 text-center">
            <h5>No orders found</h5>

            <p class="cs-muted mb-0">
                Try changing your filters.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0 cs-order-table">
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th class="text-end">Total</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (OrderResponseDTO order in FilteredOrders)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">
                                    #@order.OrderId
                                </div>
                            </td>

                            <td>
                                @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                <span class="@GetOrderStatusClass(order.Status)">
                                    @order.Status
                                </span>
                            </td>

                            <td>
                                <span class="@GetPaymentStatusClass(order.PaymentStatus)">
                                    @order.PaymentStatus
                                </span>
                            </td>

                            <td class="text-end fw-semibold">
                                @FormatCurrency(order.TotalAmount)
                            </td>

                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2 flex-wrap">
                                    <button type="button"
                                            class="btn cs-btn-detail btn-sm"
                                            @onclick="() => GoToDetail(order.OrderId)">
                                        Detail
                                    </button>

                                    @if (CanComplete(order))
                                    {
                                        <button type="button"
                                                class="btn cs-btn-cart btn-sm"
                                                disabled="@AdminOrderStateService.IsLoading"
                                                @onclick="() => CompleteOrderAsync(order.OrderId)">
                                            Complete
                                        </button>
                                    }

                                    @if (CanCancel(order))
                                    {
                                        <button type="button"
                                                class="btn cs-btn-outline btn-sm"
                                                disabled="@AdminOrderStateService.IsLoading"
                                                @onclick="() => OpenCancelBox(order.OrderId)">
                                            Cancel
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>

                        @if (CancellingOrderId == order.OrderId)
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="admin-cancel-box">
                                        <label class="form-label">
                                            Cancel Reason
                                        </label>

                                        <textarea class="form-control cs-input"
                                                  rows="2"
                                                  placeholder="Enter cancel reason..."
                                                  @bind="CancelReason">
                                        </textarea>

                                        <div class="d-flex gap-2 mt-3">
                                            <button type="button"
                                                    class="btn cs-btn-cart btn-sm"
                                                    disabled="@AdminOrderStateService.IsLoading"
                                                    @onclick="() => ConfirmCancelAsync(order.OrderId)">
                                                Confirm Cancel
                                            </button>

                                            <button type="button"
                                                    class="btn cs-btn-outline btn-sm"
                                                    disabled="@AdminOrderStateService.IsLoading"
                                                    @onclick="CloseCancelBox">
                                                Close
                                            </button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private string Keyword { get; set; } = string.Empty;

    private string SelectedStatus { get; set; } = string.Empty;

    private string SelectedPaymentStatus { get; set; } = string.Empty;

    private int? CancellingOrderId { get; set; }

    private string CancelReason { get; set; } = string.Empty;

    private List<OrderResponseDTO> FilteredOrders
    {
        get
        {
            IEnumerable<OrderResponseDTO> query = AdminOrderStateService.Orders;

            if (!string.IsNullOrWhiteSpace(Keyword))
            {
                var keyword = Keyword.Trim();

                query = query.Where(order =>
                    order.OrderId.ToString().Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase
                    ) ||
                    order.Status.Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase
                    ) ||
                    order.PaymentStatus.Contains(
                        keyword,
                        StringComparison.OrdinalIgnoreCase
                    )
                );
            }

            if (!string.IsNullOrWhiteSpace(SelectedStatus))
            {
                query = query.Where(order =>
                    order.Status.Equals(
                        SelectedStatus,
                        StringComparison.OrdinalIgnoreCase
                    )
                );
            }

            if (!string.IsNullOrWhiteSpace(SelectedPaymentStatus))
            {
                query = query.Where(order =>
                    order.PaymentStatus.Equals(
                        SelectedPaymentStatus,
                        StringComparison.OrdinalIgnoreCase
                    )
                );
            }

            return query
                .OrderByDescending(order => order.OrderDate)
                .ToList();
        }
    }

    protected override void OnInitialized()
    {
        AdminOrderStateService.OnChange += HandleOrderStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AdminOrderStateService.LoadOrdersAsync();
        }
    }

    private void HandleOrderStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ReloadOrders()
    {
        await AdminOrderStateService.LoadOrdersAsync();
    }

    private void GoToDetail(int orderId)
    {
        NavigationManager.NavigateTo($"/admin/orders/{orderId}");
    }

    private async Task CompleteOrderAsync(int orderId)
    {
        await AdminOrderStateService.CompleteOrderAsync(orderId);

        CloseCancelBox();
    }

    private void OpenCancelBox(int orderId)
    {
        CancellingOrderId = orderId;
        CancelReason = string.Empty;
    }

    private void CloseCancelBox()
    {
        CancellingOrderId = null;
        CancelReason = string.Empty;
    }

    private async Task ConfirmCancelAsync(int orderId)
    {
        if (string.IsNullOrWhiteSpace(CancelReason))
        {
            CancelReason = "Cancelled by administrator";
        }

        await AdminOrderStateService.CancelOrderAsync(
            orderId,
            CancelReason
        );

        CloseCancelBox();
    }

    private static bool CanComplete(OrderResponseDTO order)
    {
        return order.Status.Equals(
            "Paid",
            StringComparison.OrdinalIgnoreCase
        );
    }

    private static bool CanCancel(OrderResponseDTO order)
    {
        return order.Status.Equals(
                "PendingPayment",
                StringComparison.OrdinalIgnoreCase
            ) ||
            order.Status.Equals(
                "Paid",
                StringComparison.OrdinalIgnoreCase
            );
    }

    private static string FormatCurrency(decimal price)
    {
        return price.ToString("#,##0") + "đ";
    }

    private static string GetOrderStatusClass(string status)
    {
        return status.ToLower() switch
        {
            "pendingpayment" => "badge cs-status-badge cs-status-warning",
            "paid" => "badge cs-status-badge cs-status-info",
            "completed" => "badge cs-status-badge cs-status-success",
            "cancelled" => "badge cs-status-badge cs-status-danger",
            _ => "badge cs-status-badge"
        };
    }

    private static string GetPaymentStatusClass(string status)
    {
        return status.ToLower() switch
        {
            "succeeded" => "badge cs-status-badge cs-status-success",
            "failed" => "badge cs-status-badge cs-status-danger",
            "pending" => "badge cs-status-badge cs-status-warning",
            _ => "badge cs-status-badge"
        };
    }

    public void Dispose()
    {
        AdminOrderStateService.OnChange -= HandleOrderStateChanged;
    }
}