@page "/payment-result"

@inject NavigationManager NavigationManager

<PageTitle>Payment Result</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="cs-card p-4 p-md-5 text-center">
            @if (IsSuccess)
            {
                <div class="mb-4">
                    <h2 class="fw-bold mb-3">
                        Payment Successful
                    </h2>

                    <p class="cs-muted mb-0">
                        Your payment has been completed successfully.
                    </p>
                </div>
            }
            else
            {
                <div class="mb-4">
                    <h2 class="fw-bold mb-3">
                        Payment Failed
                    </h2>

                    <p class="cs-muted mb-0">
                        Your payment could not be completed.
                    </p>
                </div>
            }

            <div class="cs-card p-3 text-start mb-4">
                @if (OrderId.HasValue)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span class="cs-muted">Order ID</span>
                        <span class="fw-semibold">#@OrderId</span>
                    </div>
                }

                @if (PaymentTransactionId.HasValue)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span class="cs-muted">Transaction ID</span>
                        <span class="fw-semibold">#@PaymentTransactionId</span>
                    </div>
                }

                @if (Amount.HasValue)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span class="cs-muted">Amount</span>
                        <span class="fw-semibold">@FormatCurrency(Amount.Value)</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <div class="mt-3">
                        <div class="cs-muted small mb-1">Message</div>
                        <div>@Message</div>
                    </div>
                }
            </div>

            <div class="d-flex flex-column flex-md-row gap-3">
                <button type="button"
                        class="btn cs-btn-cart flex-fill py-2"
                        @onclick="GoToMyOrders">
                    View My Orders
                </button>

                <button type="button"
                        class="btn cs-btn-detail flex-fill py-2"
                        @onclick="ContinueShopping">
                    Continue Shopping
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Status { get; set; }

    [SupplyParameterFromQuery]
    public int? OrderId { get; set; }

    [SupplyParameterFromQuery]
    public int? PaymentTransactionId { get; set; }

    [SupplyParameterFromQuery]
    public decimal? Amount { get; set; }

    [SupplyParameterFromQuery]
    public string? Message { get; set; }

    private bool IsSuccess =>
        Status?.Equals("success", StringComparison.OrdinalIgnoreCase) == true;

    private void GoToMyOrders()
    {
        NavigationManager.NavigateTo("/my-orders");
    }

    private void ContinueShopping()
    {
        NavigationManager.NavigateTo("/products");
    }

    private static string FormatCurrency(decimal price)
    {
        return price.ToString("#,##0") + "đ";
    }
}