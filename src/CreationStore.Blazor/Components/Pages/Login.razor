@page "/login"

@using CreationStore.Blazor.DTOs.Auth
@using CreationStore.Blazor.Services

@inject UserStateService UserStateService

<PageTitle>Login</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">

        <div class="cs-card cs-auth-card p-4 p-md-5">
            <div class="mb-4">
                <h2 class="cs-auth-title mb-2">
                    Login
                </h2>

                <p class="cs-muted mb-0">
                    Don't have an account?
                    <a href="/register"
                       class="text-decoration-none"
                       style="color:#ff6f8e">
                        Register now
                    </a>
                </p>
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="alert alert-danger">
                    @ErrorMessage
                </div>
            }

            <EditForm Model="LoginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">
                        Username / Email / Phone
                    </label>

                    <div class="input-group">
                        <span class="input-group-text cs-input">
                            <i class="fas fa-user"></i>
                        </span>

                        <InputText class="form-control cs-input"
                                   placeholder="Enter username, email or phone"
                                   @bind-Value="LoginModel.LoginIdentifier" />
                    </div>

                    <ValidationMessage For="@(() => LoginModel.LoginIdentifier)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Password
                    </label>

                    <div class="input-group">
                        <span class="input-group-text cs-input">
                            <i class="fas fa-lock"></i>
                        </span>

                        <InputText class="form-control cs-input"
                                   type="password"
                                   placeholder="Enter password"
                                   @bind-Value="LoginModel.Password" />
                    </div>

                    <ValidationMessage For="@(() => LoginModel.Password)" />
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="rememberMe" />

                        <label class="form-check-label cs-muted"
                               for="rememberMe">
                            Remember me
                        </label>
                    </div>

                    <a href="#"
                       class="text-decoration-none"
                       style="color:#ff6f8e">
                        Forgot password?
                    </a>
                </div>

                <button type="submit"
                        class="btn cs-btn-primary w-100 py-2"
                        disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span>
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            Logging in...
                        </span>
                    }
                    else
                    {
                        <span>Login</span>
                    }
                </button>
            </EditForm>

            <div class="mt-4 text-center">
                <p class="cs-muted small mb-0">
                    By logging in, you agree to our
                    <a href="#"
                       class="text-decoration-none"
                       style="color:#ff6f8e">
                        Terms of Service
                    </a>
                    and
                    <a href="#"
                       class="text-decoration-none"
                       style="color:#ff6f8e">
                        Privacy Policy
                    </a>.
                </p>
            </div>
        </div>

    </div>
</div>

@code {
    private LoginDTO LoginModel { get; set; } = new();

    private bool IsLoading { get; set; }

    private string? ErrorMessage { get; set; }

    private async Task HandleLogin()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            await UserStateService.LoginAsync(LoginModel);
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }
}