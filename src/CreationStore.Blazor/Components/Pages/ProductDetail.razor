@page "/products/{ProductId:int}"

@using CreationStore.Blazor.DTOs.Products
@using CreationStore.Blazor.Services

@inject ProductStateService ProductStateService
@inject NavigationManager NavigationManager
@inject UserStateService UserStateService
@inject CartStateService CartStateService

<PageTitle>Product Detail</PageTitle>

@if (IsLoading)
{
    <div class="cs-card p-5 text-center">
        <div class="spinner-border text-light mb-3"></div>

        <p class="cs-muted mb-0">
            Loading product details...
        </p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="cs-card p-5 text-center">
        <h4 class="mb-3">
            Product not found
        </h4>

        <p class="cs-muted">
            @ErrorMessage
        </p>

        <button class="btn cs-btn-primary" @onclick="GoBackToProducts">
            Back to Products
        </button>
    </div>
}
else if (Product == null)
{
    <div class="cs-card p-5 text-center">
        <h4>
            No product data
        </h4>

        <button class="btn cs-btn-primary mt-3" @onclick="GoBackToProducts">
            Back to Products
        </button>
    </div>
}
else
{
    <div class="row g-4 align-items-stretch">
        <div class="col-12">
            <button class="btn cs-btn-outline mb-3" @onclick="GoBackToProducts">
                <i class="fas fa-arrow-left me-1"></i>
                Back to Products
            </button>
        </div>

        <div class="col-12 col-lg-6">
            <div class="cs-card h-100 overflow-hidden">
                <img src="@GetImageUrl(Product.ImageUrl)" class="w-100 h-100" style="object-fit: cover; min-height: 430px;"
                     alt="@Product.ProductName" />
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="cs-card p-4 h-100">
                <div class="mb-3">
                    <span class="badge cs-badge-cart">
                        @Product.CategoryName
                    </span>
                </div>

                <h1 class="fw-bold mb-3">
                    @Product.ProductName
                </h1>

                <p class="cs-muted mb-4">
                    @Product.Description
                </p>

                <div class="mb-4">
                    <div class="cs-muted small">
                        Price
                    </div>

                    <div class="fw-bold display-6">
                        @FormatCurrency(Product.Price)
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-md-6">
                        <div class="cs-card p-3">
                            <div class="cs-muted small">
                                Validity
                            </div>

                            <div class="fw-semibold">
                                @GetValidityText(Product.ValidityDays)
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="cs-card p-3">
                            <div class="cs-muted small">
                                Category
                            </div>

                            <div class="fw-semibold">
                                @Product.CategoryName
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(CartStateService.ErrorMessage))
                {
                    <div class="alert alert-danger">
                        @CartStateService.ErrorMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(CartStateService.SuccessMessage))
                {
                    <div class="alert alert-success">
                        @CartStateService.SuccessMessage
                    </div>
                }

                <div class="d-flex flex-column flex-md-row gap-3">
                    <button class="btn cs-btn-primary flex-fill py-2" disabled="@CartStateService.IsLoading"
                            @onclick="HandleAddToCart">
                        @if (CartStateService.IsLoading)
                        {
                            <span>
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                Adding...
                            </span>
                        }
                        else
                        {
                            <span>
                                <i class="fas fa-shopping-cart me-2"></i>
                                Add to Cart
                            </span>
                        }
                    </button>

                    <button class="btn cs-btn-outline flex-fill py-2" @onclick="GoBackToProducts">
                        Continue Shopping
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int ProductId { get; set; }

    private ProductResponseDTO? Product { get; set; }

    private bool IsLoading { get; set; } = true;

    private string? ErrorMessage { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        Product = await ProductStateService.GetProductByIdAsync(ProductId);

        if (Product == null)
        {
            ErrorMessage = "The product does not exist or has been removed.";
        }

        IsLoading = false;
    }

    private void GoBackToProducts()
    {
        NavigationManager.NavigateTo("/products");
    }

    private async Task HandleAddToCart()
    {
        if (Product == null)
        {
            return;
        }

        if (!UserStateService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await CartStateService.AddToCartAsync(Product.ProductId, 1);
    }
    
    private static string FormatCurrency(decimal price)
    {
        return price.ToString("#,##0") + "đ";
    }

    private static string GetValidityText(int? validityDays)
    {
        if (validityDays.HasValue)
        {
            return $"{validityDays.Value} days";
        }

        return "Lifetime";
    }

    private static string GetImageUrl(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl) ||
            imageUrl.Equals("string", StringComparison.OrdinalIgnoreCase))
        {
            return "https://via.placeholder.com/600x350?text=No+Image";
        }

        if (imageUrl.StartsWith("http://") ||
            imageUrl.StartsWith("https://"))
        {
            return imageUrl;
        }

        if (imageUrl.StartsWith("/"))
        {
            return imageUrl;
        }

        return $"/images/{imageUrl}";
    }
}