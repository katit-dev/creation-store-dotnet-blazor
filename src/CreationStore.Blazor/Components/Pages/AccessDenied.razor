@page "/access-denied"

@inject NavigationManager NavigationManager

<PageTitle>Access Denied</PageTitle>

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="cs-card p-4 p-md-5 text-center">
            <div class="mb-4">
                <h2 class="fw-bold mb-3">
                    Access Denied
                </h2>

                <p class="cs-muted mb-0">
                    You do not have permission to access this page.
                </p>
            </div>

            <div class="cs-card p-3 text-start mb-4">
                <div class="cs-muted small mb-2">
                    Reason
                </div>

                <div>
                    This page is only available for administrator accounts.
                </div>
            </div>

            <div class="d-flex flex-column flex-md-row gap-3">
                <button type="button"
                        class="btn cs-btn-cart flex-fill py-2"
                        @onclick="GoHome">
                    Go Home
                </button>

                <button type="button"
                        class="btn cs-btn-detail flex-fill py-2"
                        @onclick="ContinueShopping">
                    Continue Shopping
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private void GoHome()
    {
        NavigationManager.NavigateTo("/");
    }

    private void ContinueShopping()
    {
        NavigationManager.NavigateTo("/products");
    }
}