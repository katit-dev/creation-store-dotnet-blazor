@using static Microsoft.AspNetCore.Components.Web.RenderMode

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <base href="/" />

    <link rel="icon"
          type="image/png"
          href="favicon.png" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet"
          href="bootstrap/bootstrap.min.css" />

    <!-- Global CSS mặc định của Blazor -->
    <link rel="stylesheet"
          href="app.css" />

    <!-- CSS isolation generated file, có cũng được, không dùng .razor.css thì không ảnh hưởng -->
    <link rel="stylesheet"
          href="CreationStore.Blazor.styles.css" />

    <!-- FontAwesome 5 -->
    <link rel="stylesheet"
          href="https://use.fontawesome.com/releases/v5.1.1/css/all.css"
          integrity="sha384-O8whS3fhG2OnA5Kas0Y9l3cfpmYjapjI0E4theH4iuMD+pLhbf6JI0jIMfYcK3yZ"
          crossorigin="anonymous" />

    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    <!-- Bootstrap JS: cần cho dropdown, navbar toggle, modal... -->
    <script src="bootstrap/bootstrap.bundle.min.js"></script>

    <!-- Blazor Web App script -->
    <script src="_framework/blazor.web.js"></script>
</body>

</html>